# Copy to .env.local for local dev. In Vercel, add all of these under
# Project Settings -> Environment Variables (Production + Preview).

# Supabase project URL + anon (public) key — used by the public site and by
# every existing ERP page (read/write goes through RLS with this key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (Project Settings -> API -> service_role).
# SERVER-ONLY — bypasses RLS. Used only by lib/supabase/admin.ts to read/update
# school_applications, since that table's RLS intentionally blocks the anon key.
# Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password gating /admin/*. SERVER-ONLY. Anyone with this password can
# access the ERP — treat it like a real credential.
ADMIN_PASSWORD=
